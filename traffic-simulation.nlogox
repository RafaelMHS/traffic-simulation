  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="StressTest_Semaforo_Pare" repetitions="1" sequentialRunOrder="false" runMetricsEveryStep="false" timeLimit="5000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>fluxo-vermelhos</metric>
        <metric>fluxo-azuis</metric>
        <metric>tempo-total-vermelhos</metric>
        <metric>tempo-total-azuis</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="method">
          <value value="&quot;stop sign&quot;"></value>
          <value value="&quot;red light&quot;"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="red-spawn" first="1" step="1" last="35"></steppedValueSet>
        <steppedValueSet variable="blue-spawn" first="1" step="1" last="35"></steppedValueSet>
        <enumeratedValueSet variable="has-seed">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="seed" first="1" step="1" last="10"></steppedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
